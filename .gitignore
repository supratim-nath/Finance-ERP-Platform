# Dependencies
node_modules/
jspm_packages/
web_modules/
# Next.js build and cache
.next/
out/
build/
dist/

# TS build info
*.tsbuildinfo

# Python cache and virtualenvs
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.venv/
pip-log.txt
pip-delete-this-directory.txt

# Environment variables (local secrets - never commit these)
.env.local
.env.development.local
.env.test.local
.env.production.local
# Allow .env.production to be committed (contains public API URLs, not secrets)
!.env.production

# Debug and system logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
logs/
*.log
.DS_Store
Thumbs.db
